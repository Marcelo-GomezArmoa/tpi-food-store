@baseUrl = http://localhost:8000
@categoriaId = 1
@productoId = 1

### Crear categoría
POST {{baseUrl}}/categorias
Content-Type: application/json

{
  "nombre": "Bebidas",
  "descripcion": "Bebidas frías y calientes"
}

### Listar categorías
GET {{baseUrl}}/categorias

### Obtener categoría
GET {{baseUrl}}/categorias/{{categoriaId}}

### Actualizar categoría
PUT {{baseUrl}}/categorias/{{categoriaId}}
Content-Type: application/json

{
  "nombre": "Bebidas y jugos",
  "descripcion": "Bebidas, jugos y refrescos"
}

### Crear producto
POST {{baseUrl}}/productos
Content-Type: application/json

{
  "nombre": "Jugo de naranja",
  "descripcion": "Jugo natural",
  "precio_base": 2500,
  "imagenes_url": [],
  "disponible": true
}

### Listar productos
GET {{baseUrl}}/productos

### Obtener producto
GET {{baseUrl}}/productos/{{productoId}}

### Asignar categoría al producto
POST {{baseUrl}}/productos/{{productoId}}/categorias
Content-Type: application/json

{
  "categoria_id": {{categoriaId}}
}

### Listar categorías del producto
GET {{baseUrl}}/productos/{{productoId}}/categorias

### Desvincular categoría del producto
DELETE {{baseUrl}}/productos/{{productoId}}/categorias/{{categoriaId}}

### Eliminar producto
DELETE {{baseUrl}}/productos/{{productoId}}

### Eliminar categoría
DELETE {{baseUrl}}/categorias/{{categoriaId}}
