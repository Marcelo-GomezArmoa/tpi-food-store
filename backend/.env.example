# ========================================================================
# Food Store API - Variables de Entorno
# ========================================================================
# Copia este archivo como .env y rellena con tus valores

# Base de datos
# PostgreSQL es obligatorio. Reemplaza los valores de ejemplo en tu archivo .env.
DATABASE_URL=postgresql+psycopg2://usuario:contraseña@localhost:5432/food_store

# FastAPI Server Configuration (opcional)
API_HOST=0.0.0.0
API_PORT=8000

# Debug Mode (usar True solo en desarrollo)
DEBUG=False

# CORS Configuration (permitir acceso desde frontend)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT / Seguridad
# Genera una clave aleatoria y larga; nunca reutilices este marcador en producción.
SECRET_KEY=<genera-una-clave-secreta-larga-y-aleatoria>
# Algoritmo firmado para los JWT emitidos por la API.
JWT_ALGORITHM=HS256
# Tiempo de vigencia del JWT y de la cookie, en minutos.
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Nombre de la cookie HttpOnly que contiene el access token.
COOKIE_NAME=access_token
# Debe ser True en producción cuando se use HTTPS.
COOKIE_SECURE=False
# Usa "lax", "strict" o "none"; "none" requiere COOKIE_SECURE=True.
COOKIE_SAMESITE=lax

# Seed de administrador inicial (opcionales)
# Ejecuta `python seed.py` desde backend/. Para promover un usuario existente,
# configura solo su email. Para crearlo, configura también una contraseña fuerte.
SEED_ADMIN_EMAIL=<email-del-administrador>
SEED_ADMIN_PASSWORD=<contraseña-fuerte-solo-para-seed>

